# Copy to .env and fill in. Never commit the real file.

# Postgres (shared instance on the VPS, own database/user)
DATABASE_URL=postgresql+psycopg://agenda:CHANGE_ME@postgres:5432/agenda
# 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

SITE_URL=https://vgmelo.tech
ALLOWED_ORIGINS=https://vgmelo.tech
# CIDR of the Docker network Caddy talks from. X-Forwarded-For is ignored from anyone else.
TRUSTED_PROXIES=172.18.0.0/16
# Host header accepted on /api/agenda/mcp (DNS rebinding protection).
MCP_ALLOWED_HOSTS=vgmelo.tech

# Outlook > Settings > Calendar > Shared calendars > Publish a calendar > "Can view when I'm busy" > ICS link.
# Empty: only bookings made here count. Without a fetch in the last ICS_MAX_STALE_HOURS, no slots are offered.
ICS_URL=
ICS_REFRESH_MINUTES=10
ICS_MAX_STALE_HOURS=6

# Resend (same account as the portal; free plan is 100 e-mails/day in total).
RESEND_API_KEY=
EMAIL_FROM=vgmelo.tech <no-reply@vgmelo.tech>
# Where the notices and owner cancel links go. Only in the real .env, never in the repo.
OWNER_EMAIL=
OWNER_NAME=Victor Melo
# Fixed meeting room. Empty: e-mails say the link arrives before the call.
MEETING_URL=

# Rules (confirmed 2026-11-09). Monday=0.
TIMEZONE=America/Sao_Paulo
WEEKDAYS=0,1,2,3,4,5
WINDOWS=08:00-10:00,12:00-14:00,18:00-20:00
STEP_MINUTES=15
BUFFER_MINUTES=15
MIN_NOTICE_HOURS=12
MAX_DAYS_AHEAD=14
MAX_PER_DAY=2
HOLD_MINUTES=30
CHANGE_CUTOFF_HOURS=2

# Abuse limits
BOOKING_MAX_PER_IP_HOUR=5
EMAILS_PER_ADDRESS_DAY=3
MAX_FUTURE_PER_EMAIL=2
MAX_PENDING_GLOBAL=6
MAX_EMAILS_DAY=40
MCP_RATE_PER_MINUTE=30
MCP_BURST=10

# Scheduling agent. Keys used ONLY by this service. No key: the chat is hidden.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
AGENT_DAILY_TOKENS=100000
AGENT_MAX_TOKENS=400
AGENT_MAX_PER_IP_HOUR=20
